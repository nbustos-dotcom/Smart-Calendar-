# Use npm's legacy peer-dependency resolution.
#
# WHY: our test tooling (vitest 5) declares a peer requirement for a newer
# @types/node than the Next.js scaffold pins. That conflict is only among dev/
# test packages — nothing in the app runtime — so we let npm install proceed
# instead of failing. Committed here so every machine (local + Vercel) installs
# the same way.
legacy-peer-deps=true
