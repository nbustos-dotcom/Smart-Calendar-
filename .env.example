# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored — never commit real secrets.

# --- Supabase (from your Supabase project: Settings -> API) ---
# The project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" public key. Safe to expose to the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- App encryption key (server-only) ---
# Used to encrypt the Canvas token before it is stored in the database.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be a base64 string that decodes to exactly 32 bytes.
APP_ENCRYPTION_KEY=

# --- Site URL (used to build the OAuth redirect) ---
# Local dev: http://localhost:3000
# Production: your Vercel URL, e.g. https://smart-calendar.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Calendar OAuth (read-only) ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The OAuth callback URL. Must EXACTLY match a redirect URI registered on the
# OAuth client in Google Cloud Console.
# Local dev:   http://localhost:3000/api/google/callback
# Production:  https://smart-calendar-sigma-ten.vercel.app/api/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback
